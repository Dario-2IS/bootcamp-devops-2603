###############################################################################
# terraform.tfvars.example
# Copia este archivo a terraform.tfvars y completa los valores.
# NUNCA subas terraform.tfvars al control de versiones si contiene secretos.
###############################################################################

project_name       = "mi-proyecto"
environment        = "dev"
aws_region         = "us-east-1"

# Red
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"

# Seguridad — reemplaza con tu IP pública
ssh_allowed_cidrs  = ["0.0.0.0/0"]  # <-- ej: ["203.0.113.10/32"]

# EC2
instance_type      = "t3.micro"
root_volume_size   = 20

# ── KEY PAIR ──────────────────────────────────────────────────────────────────
# Nombre exacto del key pair en la consola de AWS → EC2 → Key Pairs
key_pair_name      = "mi-key-pair"   # <-- reemplaza con el nombre de tu key pair
# ─────────────────────────────────────────────────────────────────────────────
